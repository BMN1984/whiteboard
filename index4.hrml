<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>سبورة أكاديمية الفتح لعلوم القرآن حفظ وتجويد وتفسير</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Amiri:wght@400;700&family=Reem+Kufi:wght@600;700;800&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet">
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
    }
    body {
      overflow: hidden;
      background-color: #064e3b;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #d1d5db;
    }

    /* البنر الدعائي لدار التحفيظ بأعلى الشاشة */
    .academy-marquee-banner {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      background: linear-gradient(90deg, #1e1b4b, #78350f, #064e3b, #78350f, #1e1b4b);
      background-size: 300% 300%;
      animation: bannerGradient 10s ease infinite;
      border-bottom: 2px solid #facc15;
      padding: 4px 0;
      z-index: 1100;
      display: flex;
      align-items: center;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
      overflow: hidden;
    }
    @keyframes bannerGradient {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
    .marquee-track {
      display: inline-block;
      white-space: nowrap;
      animation: marqueeScroll 28s linear infinite;
      font-family: 'Reem Kufi', sans-serif;
      font-size: 15px;
      font-weight: bold;
      color: #fef08a;
      text-shadow: 0 0 10px rgba(250, 204, 21, 0.6);
    }
    .marquee-track:hover { animation-play-state: paused; }
    @keyframes marqueeScroll {
      0% { transform: translateX(100%); }
      100% { transform: translateX(-100%); }
    }
    .badge-sparkle {
      background: #facc15;
      color: #1e1b4b;
      padding: 2px 10px;
      border-radius: 12px;
      margin: 0 8px;
      font-size: 12px;
    }

    #celebrationOverlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1500;
      overflow: hidden;
    }
    .floating-item {
      position: absolute;
      font-size: 32px;
      animation: floatUp 2.8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
    }
    @keyframes floatUp {
      0% { transform: translateY(100vh) scale(0.6) rotate(0deg); opacity: 0; }
      20% { opacity: 1; }
      80% { opacity: 0.9; }
      100% { transform: translateY(-15vh) scale(1.4) rotate(360deg); opacity: 0; }
    }

    /* حاوية العرض والتحجيم الكلية للسبورة (Board Stage Scaling) */
    #boardStage {
      position: absolute;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      transform-origin: 50% 50%;
      transition: transform 0.15s ease-out;
    }

    /* صناديق النصوص الحرة المستقلة والقابلة للتكبير والتصغير من الحواف */
    .custom-textbox-widget {
      position: absolute;
      z-index: 150;
      min-width: 260px;
      min-height: 160px;
      width: 380px;
      height: 220px;
      background: rgba(15, 23, 42, 0.96);
      border: 2px solid #38bdf8;
      border-radius: 12px;
      box-shadow: 0 15px 40px rgba(0,0,0,0.85);
      direction: rtl;
      display: flex;
      flex-direction: column;
      resize: both;
      overflow: hidden;
    }
    .widget-drag-bar {
      background: #1e293b;
      padding: 6px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: grab;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      flex-shrink: 0;
    }
    .widget-drag-bar:active { cursor: grabbing; }
    .widget-drag-label {
      font-size: 11px;
      color: #38bdf8;
      font-weight: bold;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .widget-toolbar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 5px;
      padding: 6px 10px;
      background: rgba(30, 41, 59, 0.9);
      border-bottom: 1px solid rgba(255,255,255,0.08);
      flex-shrink: 0;
    }
    .w-btn {
      background: rgba(255,255,255,0.08);
      border: 1px solid rgba(255,255,255,0.15);
      color: #fff;
      border-radius: 6px;
      padding: 3px 8px;
      font-size: 11px;
      cursor: pointer;
      font-weight: bold;
      transition: background 0.15s;
    }
    .w-btn:hover { background: #0284c7; }
    .w-btn.active { background: #0284c7; border-color: #38bdf8; }
    .w-select {
      background: #0b111e;
      border: 1px solid rgba(255,255,255,0.2);
      color: #fff;
      border-radius: 6px;
      padding: 3px 6px;
      font-size: 11px;
      outline: none;
    }
    .w-editor-area {
      flex: 1;
      width: 100%;
      height: 100%;
      padding: 10px 14px;
      background: transparent;
      border: none;
      outline: none;
      color: #ffffff;
      font-size: 28px;
      line-height: 1.8;
      font-family: 'Traditional Arabic', 'Scheherazade New', 'Amiri', serif;
      direction: rtl;
      user-select: text;
      resize: none;
    }
    .w-del-btn {
      background: transparent;
      border: none;
      color: #f87171;
      font-size: 14px;
      cursor: pointer;
      padding: 0 4px;
    }
    .w-del-btn:hover { color: #ef4444; }

    .resize-handle-corner {
      position: absolute;
      bottom: 2px;
      left: 2px;
      width: 16px;
      height: 16px;
      cursor: sw-resize;
      background: linear-gradient(135deg, transparent 50%, #38bdf8 50%);
      border-bottom-left-radius: 8px;
      pointer-events: auto;
    }

    /* صندوق المصحف المطور: مستقل تماماً وقابل لتغيير المقاس بالكامل من الحواف */
    #quranTextContainer {
      position: absolute;
      top: 16%;
      left: 20%;
      z-index: 50;
      display: none;
      min-width: 320px;
      min-height: 220px;
      width: 62vw;
      max-width: 920px;
      height: 72vh;
      background: rgba(15, 23, 42, 0.96);
      backdrop-filter: blur(14px);
      border: 2px solid #d97706;
      border-radius: 18px;
      box-shadow: 0 20px 50px rgba(0,0,0,0.85), 0 0 25px rgba(217, 119, 6, 0.3);
      direction: rtl;
      cursor: default;
      resize: both; /* تمكين التكبير والتصغير من جميع الحواف */
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .drag-header {
      background: linear-gradient(90deg, #1e293b, #0f172a);
      border-bottom: 1px solid rgba(217, 119, 6, 0.3);
      padding: 8px 14px;
      border-top-left-radius: 16px;
      border-top-right-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: grab;
      flex-shrink: 0;
    }
    .drag-header:active { cursor: grabbing; }
    .drag-title {
      font-size: 12px;
      color: #fbbf24;
      font-weight: bold;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .card-close-btn {
      background: rgba(255,255,255,0.1);
      border: none;
      color: #cbd5e1;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 11px;
    }
    .card-close-btn:hover { background: #dc2626; color: #fff; }

    .card-body {
      flex: 1;
      padding: 16px 24px;
      overflow-y: auto;
      text-align: center;
    }

    /* مقبض الزاوية الذهبي لتغيير أبعاد صندوق المصحف */
    .quran-resize-corner {
      position: absolute;
      bottom: 2px;
      left: 2px;
      width: 18px;
      height: 18px;
      cursor: sw-resize;
      background: linear-gradient(135deg, transparent 50%, #f59e0b 50%);
      border-bottom-left-radius: 12px;
      pointer-events: auto;
    }

    .audio-toolbar {
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: rgba(30, 41, 59, 0.95);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      padding: 10px 14px;
      margin-bottom: 14px;
    }
    .toolbar-row {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
    }
    .audio-btn {
      background: #0284c7;
      border: 1px solid #38bdf8;
      color: #fff;
      padding: 5px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 5px;
      transition: background 0.15s;
    }
    .audio-btn:hover { background: #0369a1; }
    .audio-btn.download-btn { background: #059669; border-color: #34d399; }
    .audio-btn.download-btn:hover { background: #047857; }
    .audio-btn.sec-btn { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.15); }
    .audio-btn.sec-btn:hover { background: rgba(255, 255, 255, 0.18); }

    .audio-select {
      background: #0b111e;
      border: 1px solid rgba(255,255,255,0.2);
      color: #e2e8f0;
      padding: 5px 8px;
      border-radius: 6px;
      font-size: 11px;
      outline: none;
      cursor: pointer;
    }

    .interval-box {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(245, 158, 11, 0.3);
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 11px;
      color: #fbbf24;
    }
    .interval-slider {
      width: 85px;
      accent-color: #f59e0b;
      cursor: pointer;
      height: 4px;
    }
    .countdown-bar-container {
      width: 100%;
      height: 4px;
      background: rgba(255,255,255,0.1);
      border-radius: 4px;
      overflow: hidden;
      display: none;
      margin-top: 4px;
    }
    .countdown-bar-fill {
      height: 100%;
      width: 0%;
      background: #10b981;
      transition: width 0.1s linear;
    }

    .surah-header-badge {
      display: inline-block;
      background: linear-gradient(135deg, #d97706, #78350f);
      color: #ffffff;
      font-size: 15px;
      font-weight: bold;
      padding: 5px 22px;
      border-radius: 30px;
      margin-bottom: 14px;
      border: 1px solid #fef3c7;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }
    #quranTextContent {
      font-family: 'Amiri Quran', 'Amiri', serif;
      line-height: 2.3;
      letter-spacing: 0.6px;
      transition: filter 0.3s ease;
    }
    #quranTextContent.blurred-text {
      filter: blur(8px);
      user-select: none;
    }

    .ayah-span {
      display: inline;
      padding: 2px 6px;
      border-radius: 8px;
      transition: all 0.3s ease;
    }
    .ayah-span.active-highlight {
      background: rgba(250, 204, 21, 0.22);
      box-shadow: 0 0 16px rgba(250, 204, 21, 0.45);
      border-bottom: 2.5px solid #facc15;
      color: #ffffff !important;
      text-shadow: 0 0 8px rgba(250, 204, 21, 0.8);
    }

    #mushafContainer {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
      display: none;
      box-shadow: 0 14px 45px rgba(0, 0, 0, 0.85);
      border-radius: 8px;
      overflow: hidden;
      background: #ffffff;
      border: 2px solid #b45309;
    }
    #mushafImg {
      display: block;
      max-height: 88vh;
      max-width: 52vw;
      object-fit: contain;
      pointer-events: none;
    }

    /* طبقات الكانفاس */
    #gridCanvas { position: absolute; top: 0; left: 0; pointer-events: none; z-index: 1; }
    #pdfCanvas { position: absolute; top: 0; left: 0; pointer-events: none; z-index: 2; }
    #paintCanvas { position: absolute; top: 0; left: 0; cursor: crosshair; touch-action: none; z-index: 3; }
    #overlayCanvas { position: absolute; top: 0; left: 0; pointer-events: none; z-index: 4; }

    .panel {
      position: fixed;
      background: rgba(18, 24, 38, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
      z-index: 100;
      transition: transform 0.3s ease, opacity 0.3s ease;
    }
    .top-bar {
      top: 36px;
      left: 50%;
      transform: translateX(-50%);
      padding: 6px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13px;
    }

    /* وحدة التحكم بالتحجيم والـ Scale للبروجيكتور */
    .scale-control-box {
      display: flex;
      align-items: center;
      gap: 4px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 10px;
      padding: 2px 6px;
    }
    .scale-btn {
      background: rgba(255, 255, 255, 0.1);
      border: none;
      color: #fff;
      font-weight: bold;
      width: 24px;
      height: 24px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
    }
    .scale-btn:hover { background: #0284c7; }
    .scale-text {
      font-size: 11px;
      font-weight: bold;
      color: #38bdf8;
      min-width: 44px;
      text-align: center;
      cursor: pointer;
    }

    .praise-dock {
      display: flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.08);
      padding: 3px 8px;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .praise-btn {
      background: transparent;
      border: none;
      font-size: 18px;
      cursor: pointer;
      padding: 3px 6px;
      border-radius: 6px;
      transition: transform 0.15s, background 0.15s;
    }
    .praise-btn:hover {
      transform: scale(1.25);
      background: rgba(255, 255, 255, 0.15);
    }

    .btn-meet {
      background: #1a73e8;
      color: #fff;
      border: 1px solid #4285f4;
      border-radius: 8px;
      padding: 5px 12px;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: background 0.2s;
    }
    .btn-meet:hover { background: #1557b0; }

    .side-left {
      top: 36px;
      left: 14px;
      width: 240px;
      max-height: 92vh;
      overflow-y: auto;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .side-right {
      top: 36px;
      right: 14px;
      width: 220px;
      max-height: 92vh;
      overflow-y: auto;
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .panel.closed-left { transform: translateX(-280px); opacity: 0; pointer-events: none; }
    .panel.closed-right { transform: translateX(260px); opacity: 0; pointer-events: none; }

    .academy-badge-sub {
      font-size: 11px;
      color: #facc15;
      font-weight: bold;
      text-align: center;
      background: rgba(217, 119, 6, 0.2);
      border: 1px solid rgba(217, 119, 6, 0.4);
      padding: 5px 8px;
      border-radius: 8px;
      line-height: 1.4;
    }

    .panel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      padding-bottom: 8px;
      font-size: 12px;
      font-weight: 700;
      color: #93c5fd;
      line-height: 1.4;
    }
    .close-btn {
      background: transparent;
      border: none;
      color: #9ca3af;
      cursor: pointer;
      font-size: 15px;
      padding: 2px 6px;
      border-radius: 4px;
    }
    .close-btn:hover { background: rgba(255,255,255,0.1); color: #fff; }

    .section-label {
      font-size: 11px;
      font-weight: 600;
      color: #9ca3af;
      margin-bottom: 4px;
    }
    .color-palette {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
    }
    .palette-dot {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s;
    }
    .palette-dot:hover { transform: scale(1.15); }
    .palette-dot.active { border-color: #fff; transform: scale(1.15); }

    .btn-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .btn-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; }

    .side-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.07);
      color: #e5e7eb;
      padding: 6px 8px;
      border-radius: 8px;
      font-size: 11px;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
    }
    .side-btn:hover { background: rgba(255, 255, 255, 0.12); }
    .side-btn.active { background: #2563eb; border-color: #3b82f6; color: #fff; }
    .btn-green-spec { background: #059669; border-color: #10b981; color: #fff; font-weight: 600; }

    .slider-group { display: flex; flex-direction: column; gap: 2px; }
    .slider-info { display: flex; justify-content: space-between; font-size: 10px; color: #9ca3af; }
    input[type="range"] { width: 100%; accent-color: #38bdf8; cursor: pointer; height: 4px; }

    .bottom-dock {
      bottom: 16px;
      left: 50%;
      transform: translateX(-50%);
      padding: 8px 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 100;
    }
    .dock-row { display: flex; align-items: center; justify-content: center; gap: 8px; }
    .dock-btn {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
      color: #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .dock-btn:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-2px); }
    .dock-btn.active {
      background: #0284c7;
      border-color: #38bdf8;
      color: #fff;
      box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
    }
    .dock-btn.btn-sq-color { border-radius: 8px; }

    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }
    .modal-overlay.active { display: flex; }
    .quran-modal {
      width: 530px;
      max-width: 92vw;
      background: #141a29;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 22px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
      display: flex;
      flex-direction: column;
      gap: 14px;
      direction: rtl;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; }
    .modal-title { color: #14b8a6; font-size: 16px; font-weight: bold; display: flex; align-items: center; gap: 8px; }
    .modal-close {
      background: #1e293b;
      border: none;
      color: #94a3b8;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
    }
    .modal-close:hover { background: #334155; color: #fff; }

    .tabs-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .tab-btn {
      background: #1e293b;
      border: 1px solid rgba(255, 255, 255, 0.05);
      color: #94a3b8;
      padding: 10px;
      border-radius: 10px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .tab-btn.active {
      background: #0f172a;
      color: #38bdf8;
      border-color: #0284c7;
    }

    .custom-select {
      width: 100%;
      background: #0b111e;
      color: #e2e8f0;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 9px;
      font-size: 13px;
      outline: none;
    }
    .quran-field {
      width: 100%;
      background: #0b111e;
      border: 1px solid #1e293b;
      border-radius: 8px;
      padding: 9px;
      color: #fff;
      font-size: 13px;
      outline: none;
      text-align: center;
    }
    .quran-color-picker {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }
    .quran-color-dot {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      cursor: pointer;
      border: 2px solid transparent;
      transition: transform 0.15s;
    }
    .quran-color-dot:hover { transform: scale(1.15); }
    .quran-color-dot.active { border-color: #fff; transform: scale(1.15); }

    .modal-footer { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
    .modal-footer-btns { display: flex; gap: 10px; }
    .btn-modal-cancel {
      flex: 1;
      background: #1e293b;
      color: #cbd5e1;
      border: none;
      border-radius: 8px;
      padding: 11px;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-modal-submit {
      flex: 2;
      background: #0d9488;
      color: #fff;
      border: none;
      border-radius: 8px;
      padding: 11px;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }
    .btn-modal-submit:hover { background: #0f766e; }

    .btn-offline-sync {
      background: rgba(245, 158, 11, 0.15);
      border: 1px dashed #f59e0b;
      color: #fde68a;
      border-radius: 8px;
      padding: 8px;
      font-size: 12px;
      font-weight: bold;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s;
    }
    .btn-offline-sync:hover { background: #f59e0b; color: #1e1b4b; }

    .toggle-panel-btn {
      position: fixed;
      top: 38px;
      z-index: 99;
      background: rgba(18, 24, 38, 0.85);
      border: 1px solid rgba(255,255,255,0.1);
      color: #fff;
      padding: 6px 10px;
      border-radius: 8px;
      cursor: pointer;
      display: none;
      font-size: 12px;
    }
    #toggleLeftBtn { left: 14px; }
    #toggleRightBtn { right: 14px; }
  </style>
</head>
<body>

  <!-- البنر الدعائي لدار التحفيظ -->
  <div class="academy-marquee-banner">
    <div class="marquee-track">
      🌟 مرحباً بكم في سبورة <span style="color:#ffffff; font-weight:800; font-size:16px;">أكاديمية الفتح لعلوم القرآن الكريم</span> 
      <span class="badge-sparkle">حفظ وتجويد وتفسير</span> 
      تحت إشراف <span style="color:#38bdf8;">نخبة متميزة من أكفأ المعلمات المتخصصات والمجازات</span> بالسند المتصل 🌸 
      نسأل الله تعالى التوفيق والسداد لجميع أبنائنا وبناتنا الطلاب والطالبات 🌿
    </div>
  </div>

  <div id="celebrationOverlay"></div>

  <button class="toggle-panel-btn" id="toggleLeftBtn">☰ سبورة الأكاديمية</button>
  <button class="toggle-panel-btn" id="toggleRightBtn">☰ أدوات الرسم</button>

  <!-- شريط التحكم العلوي المطور مع وحدة تحجيم البروجيكتور والـ Scale -->
  <div class="panel top-bar">
    <div class="praise-dock">
      <button class="praise-btn" id="btnClap" title="تصفيق حار">👏</button>
      <button class="praise-btn" id="btnStars" title="مطر النجوم">⭐</button>
      <button class="praise-btn" id="btnHearts" title="قلوب طائرة">💖</button>
      <button class="praise-btn" id="btnParty" title="احتفال كامل">🎊</button>
    </div>

    <!-- أداة تحجيم السبورة والـ Scale للعرض على البروجيكتور -->
    <div class="scale-control-box" title="تكبير وتصغير مقاس السبورة بالكامل للبروجيكتور">
      <button class="scale-btn" id="btnZoomOut" title="تصغير السبورة">−</button>
      <span class="scale-text" id="scaleIndicator" title="انقر لإعادة الضبط إلى 100%">100%</span>
      <button class="scale-btn" id="btnZoomIn" title="تكبير السبورة">+</button>
    </div>

    <button class="btn-meet" id="btnGoogleMeet" title="مشاركة الشاشة عبر Google Meet">
      <span>📹</span>
      <span>Google Meet</span>
    </button>

    <button class="side-btn" id="fullScreenBtn" style="padding:4px 8px;">⛶ ملء الشاشة</button>
  </div>

  <!-- مسرح التحجيم الكلي للسبورة والبروجيكتور (Board Stage) -->
  <div id="boardStage">
    <!-- حاوية الصناديق النصية الحرة المستقلة -->
    <div id="textWidgetsContainer"></div>

    <!-- 1. حاوية الآيات القابلة للتحريك المنفصل والتكبير والتصغير من الحواف -->
    <div id="quranTextContainer">
      <div class="drag-header" id="dragHeader">
        <div class="drag-title">
          <span>✥</span>
          <span>أدوات مصحف الشرح — اسحب لتحريك الموضع بشكل منفصل</span>
        </div>
        <button class="card-close-btn" id="closeQuranCardBtn" title="إغلاق اللوحة">✕</button>
      </div>

      <div class="card-body">
        <div class="audio-toolbar">
          <div class="toolbar-row">
            <button class="audio-btn sec-btn" id="btnPrevAyah" title="الآية السابقة">⏮️</button>
            <button class="audio-btn" id="btnPlayAudio">▶️ تشغيل التلاوة</button>
            <button class="audio-btn sec-btn" id="btnNextAyah" title="الآية التالية">⏭️</button>
            <button class="audio-btn download-btn" id="btnDownloadAudio" title="تحميل التلاوة الحالية أوفلاين">📥 حفظ أوفلاين</button>
            <button class="audio-btn sec-btn" id="btnToggleBlur" title="إخفاء النص لاختبار الحفظ (تسميع)">👁️ إخفاء النص</button>
          </div>

          <div class="toolbar-row">
            <select class="audio-select" id="reciterSelect" title="اختيار القارئ">
              <option value="Husary_64kbps">محمود خليل الحصري (مرتل)</option>
              <option value="Minshawy_Murattal_128kbps">محمد صديق المنشاوي (مرتل)</option>
              <option value="Abdul_Basit_Murattal_64kbps">عبد الباسط عبد الصمد (مرتل)</option>
              <option value="Alafasy_128kbps">مشاري راشد العفاسي</option>
            </select>

            <select class="audio-select" id="playbackSpeedSelect" title="سرعة التلاوة">
              <option value="0.75">سرعة: 0.75x (تعليمي بطيء)</option>
              <option value="1.0" selected>سرعة: 1.0x (عادي)</option>
              <option value="1.25">سرعة: 1.25x (سريع)</option>
            </select>

            <select class="audio-select" id="loopSelect" title="تكرار المجموعة">
              <option value="1">تشغيل مرة واحدة</option>
              <option value="3">تكرار 3 مرات</option>
              <option value="5">تكرار 5 مرات</option>
              <option value="999">تكرار مستمر</option>
            </select>

            <div class="interval-box" title="الفاصل الزمني بالثواني لترديد الطالب بين الآيات">
              <span>⏱️ الفاصل الزمني:</span>
              <input type="range" id="intervalSlider" class="interval-slider" min="0" max="25" value="4">
              <span id="intervalSecDisplay" style="font-weight:bold; min-width:24px;">4 ث</span>
            </div>
          </div>
          
          <div class="countdown-bar-container" id="countdownBarContainer">
            <div class="countdown-bar-fill" id="countdownBarFill"></div>
          </div>

          <div id="audioStatus" style="font-size:11px; color:#38bdf8; width:100%; margin-top:2px;">جاهز للاستماع</div>
        </div>

        <div class="surah-header-badge" id="surahBadgeTitle">سورة الفاتحة</div>
        <div id="quranTextContent"></div>
      </div>

      <!-- مقبض زاوية السحب لتغيير حجم صندوق المصحف بحرية -->
      <div class="quran-resize-corner" id="quranResizeCorner" title="اسحب لتكبير أو تصغير حجم صندوق المصحف"></div>
    </div>

    <!-- 2. عنصر عرض صفحة المصحف العثماني المصورة -->
    <div id="mushafContainer">
      <img id="mushafImg" src="" alt="صفحة المصحف الشريف" crossorigin="anonymous" referrerpolicy="no-referrer">
    </div>

    <canvas id="gridCanvas"></canvas>
    <canvas id="pdfCanvas"></canvas>
    <canvas id="paintCanvas"></canvas>
    <canvas id="overlayCanvas"></canvas>
  </div>

  <!-- اللوحة الجانبية اليسرى -->
  <div class="panel side-left" id="leftPanel">
    <div class="panel-header">
      <span>أكاديمية الفتح لعلوم القرآن</span>
      <button class="close-btn" id="closeLeftBtn">✕</button>
    </div>

    <div class="academy-badge-sub">
      ✨ حفظ وتجويد وتفسير ✨<br>
      🌸 نخبة من أكفأ المعلمات 🌸
    </div>

    <div class="section-label">لون السبورة</div>
    <div class="color-palette">
      <div class="palette-dot" style="background: #12161f;" data-bg="#12161f"></div>
      <div class="palette-dot active" style="background: #064e3b;" data-bg="#064e3b"></div>
      <div class="palette-dot" style="background: #1e3a8a;" data-bg="#1e3a8a"></div>
      <div class="palette-dot" style="background: #0f172a;" data-bg="#0f172a"></div>
      <div class="palette-dot" style="background: #ffffff;" data-bg="#ffffff"></div>
      <div class="palette-dot" style="background: #7f1d1d;" data-bg="#7f1d1d"></div>
      <div class="palette-dot" style="background: #374151;" data-bg="#374151"></div>
      <div class="palette-dot" style="background: #facc15;" data-bg="#facc15"></div>
      <div class="palette-dot" style="background: #0284c7;" data-bg="#0284c7"></div>
      <div class="palette-dot" style="background: #000000;" data-bg="#000000"></div>
    </div>

    <div class="section-label">تخطيط الأسطر والشبكة</div>
    <div class="btn-grid-3">
      <button class="side-btn" data-grid="none">سادة</button>
      <button class="side-btn" data-grid="graph">شبكة</button>
      <button class="side-btn" data-grid="ruled">مسطر</button>
      <button class="side-btn active" data-grid="two-lines">سطرين معاً</button>
      <button class="side-btn" data-grid="four-lines">4 أسطر</button>
      <button class="side-btn" data-grid="wide-ruled">عريض</button>
    </div>

    <div class="section-label">المشروع والتصدير</div>
    <button class="side-btn" id="downloadPngBtn">📷 تصدير صورة PNG</button>
    <button class="side-btn" id="downloadJpgBtn">🖼️ تصدير صورة JPG</button>
    <button class="side-btn" id="clearBoardBtn" style="color:#f87171;">🗑️ مسح لوحة الشرح</button>
  </div>

  <!-- اللوحة الجانبية اليمنى -->
  <div class="panel side-right" id="rightPanel">
    <div class="panel-header">
      <button class="side-btn" id="undoBtn" style="padding:2px 8px;">↩️ التراجع</button>
      <span id="pageIndicator" style="font-size:11px;">صفحة 1 / 1</span>
      <button class="close-btn" id="closeRightBtn">✕</button>
    </div>

    <div class="section-label">ألوان القلم / الرسم</div>
    <div class="color-palette">
      <div class="palette-dot active" style="background: #ffffff;" data-color="#ffffff"></div>
      <div class="palette-dot" style="background: #facc15;" data-color="#facc15"></div>
      <div class="palette-dot" style="background: #4ade80;" data-color="#4ade80"></div>
      <div class="palette-dot" style="background: #38bdf8;" data-color="#38bdf8"></div>
      <div class="palette-dot" style="background: #fb923c;" data-color="#fb923c"></div>
      <div class="palette-dot" style="background: #f87171;" data-color="#f87171"></div>
      <div class="palette-dot" style="background: #c084fc;" data-color="#c084fc"></div>
      <div class="palette-dot" style="background: #f472b6;" data-color="#f472b6"></div>
      <div class="palette-dot" style="background: #2dd4bf;" data-color="#2dd4bf"></div>
      <div class="palette-dot" style="background: #94a3b8;" data-color="#94a3b8"></div>
    </div>

    <div class="slider-group">
      <div class="slider-info"><span>سُمك القلم</span><span id="sizeVal">4px</span></div>
      <input type="range" id="brushSize" min="2" max="45" value="4">
    </div>

    <div class="slider-group">
      <div class="slider-info"><span>درجة الشفافية</span><span id="opacityVal">100%</span></div>
      <input type="range" id="brushOpacity" min="10" max="100" value="100">
    </div>

    <div class="section-label">استيراد وسائط وعمليات</div>
    <div class="btn-grid-2">
      <button class="side-btn" id="uploadPdfBtn">📑 شرح PDF</button>
      <button class="side-btn" id="uploadImgBtn">🖼️ إدراج صورة</button>
    </div>
    <button class="side-btn btn-green-spec" id="openQuranBtn">📖 آيات القرآن</button>

    <input type="file" id="pdfInput" accept="application/pdf" style="display:none;">
    <input type="file" id="imageInput" accept="image/*" style="display:none;">
  </div>

  <!-- شريط الأدوات السفلي -->
  <div class="panel bottom-dock">
    <div class="dock-row">
      <button class="dock-btn" id="redoBtn" title="إعادة">↪️</button>
      <button class="dock-btn" data-tool="hand" title="تحريك وسحب السبورة">✋</button>
      <button class="dock-btn" data-tool="text" title="إدراج مربع نص للكتابة والتحكم المستقل">A</button>
      <button class="dock-btn active" data-tool="pen" title="قلم">✏️</button>
      <button class="dock-btn" data-tool="highlighter" title="تظليل">🖊️</button>
      <button class="dock-btn" data-tool="laser" title="مؤشر ليزر">🔴</button>
      <button class="dock-btn" data-tool="eraser" title="ممحاة">🧹</button>
      <button class="dock-btn" data-tool="line" title="خط">📏</button>
      <button class="dock-btn" data-tool="arrow" title="سهم">➡️</button>
      <button class="dock-btn" data-tool="rect" title="مستطيل">▭</button>
      <button class="dock-btn" data-tool="circle" title="دائرة">◯</button>
    </div>
    <div class="dock-row">
      <button class="dock-btn" id="prevPageBtn" title="السابق">◀</button>
      <button class="dock-btn" id="nextPageBtn" title="التالي">▶</button>
      <button class="dock-btn btn-sq-color" style="background:#a855f7;" data-color="#a855f7"></button>
      <button class="dock-btn btn-sq-color" style="background:#0284c7;" data-color="#0284c7"></button>
      <button class="dock-btn btn-sq-color" style="background:#22c55e;" data-color="#22c55e"></button>
      <button class="dock-btn btn-sq-color" style="background:#eab308;" data-color="#eab308"></button>
      <button class="dock-btn btn-sq-color" style="background:#ef4444;" data-color="#ef4444"></button>
      <button class="dock-btn" title="حفظ سريع" id="quickSaveBtn">💾</button>
    </div>
  </div>

  <!-- النافذة المنبثقة للقرآن الكريم -->
  <div class="modal-overlay" id="quranModal">
    <div class="quran-modal">
      <div class="modal-header">
        <button class="modal-close" id="closeQuranModalBtn">✕</button>
        <div class="modal-title">
          <span>📖</span>
          <span>استخراج وعرض آيات القرآن الكريم</span>
        </div>
      </div>

      <div class="tabs-row">
        <button class="tab-btn active" id="tabCustomText">✨ خط عريض ومزخرف وملون</button>
        <button class="tab-btn" id="tabMushafImage">📜 مصحف المدينة (طبعة مصورة)</button>
      </div>

      <div id="customTextSection" style="display: flex; flex-direction: column; gap: 10px;">
        <div class="input-label" style="font-size:12px;">اختر السورة والآيات:</div>
        <select id="textSurahSelect" class="custom-select"></select>
        <div style="display:flex; gap:8px;">
          <input type="number" id="verseFrom" class="quran-field" placeholder="من آية" min="1" value="1">
          <input type="number" id="verseTo" class="quran-field" placeholder="إلى آية" min="1" value="7">
        </div>

        <div class="input-label" style="font-size:12px; margin-top:4px;">اختر لون الآيات:</div>
        <div class="quran-color-picker">
          <div class="quran-color-dot active" style="background:#fef08a;" data-text-color="#fef08a" title="ذهبي فاتح"></div>
          <div class="quran-color-dot" style="background:#ffffff;" data-text-color="#ffffff" title="أبيض ناصع"></div>
          <div class="quran-color-dot" style="background:#67e8f9;" data-text-color="#67e8f9" title="سماوي مريح"></div>
          <div class="quran-color-dot" style="background:#86efac;" data-text-color="#86efac" title="أخضر زمردي"></div>
          <div class="quran-color-dot" style="background:#fbcfe8;" data-text-color="#fbcfe8" title="وردي هادئ"></div>
          <div class="quran-color-dot" style="background:#fdba74;" data-text-color="#fdba74" title="برتقالي دافئ"></div>
          <input type="color" id="customColorInput" value="#fef08a" style="width:28px; height:28px; border:none; border-radius:50%; cursor:pointer; background:none;">
        </div>

        <div style="display:flex; justify-content:space-between; font-size:11px; color:#9ca3af; margin-top:4px;">
          <span>حجم الخط المزخرف:</span>
          <span id="fontSizeDisplay">34px</span>
        </div>
        <input type="range" id="quranFontSizeSlider" min="22" max="52" value="34">
      </div>

      <div id="mushafImageSection" style="display: none;">
        <div class="input-label" style="margin-bottom:6px; font-size:12px;">أدخل رقم صفحة المصحف (من 1 إلى 604) أو اختر السورة:</div>
        <div style="display:flex; gap:8px; margin-bottom:10px;">
          <input type="number" id="quranPageInput" class="quran-field" style="width:100px;" value="1" min="1" max="604" placeholder="رقم">
          <select id="quickSurahSelect" class="custom-select" style="flex:1;"></select>
        </div>
        <div style="font-size:11px; color:#38bdf8;">* سيتم عرض الصفحة الأصلية الكاملة لطبعة مجمع الملك فهد بإطارها وزخارفها.</div>
      </div>

      <button class="btn-offline-sync" id="btnSyncQuranOffline">
        📦 تحميل وتخزين القرآن الكريم كاملاً للعمل دون إنترنت (Offline)
      </button>

      <div class="modal-footer">
        <div class="modal-footer-btns">
          <button class="btn-modal-cancel" id="cancelQuranModalBtn">إلغاء</button>
          <button class="btn-modal-submit" id="submitQuranBtn">
            <span>📖</span>
            <span id="submitBtnText">إدراج الآيات المزخرفة الملونة</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    const boardStage = document.getElementById('boardStage');
    const paintCanvas = document.getElementById('paintCanvas');
    const pCtx = paintCanvas.getContext('2d');
    const gridCanvas = document.getElementById('gridCanvas');
    const gCtx = gridCanvas.getContext('2d');
    const pdfCanvas = document.getElementById('pdfCanvas');
    const pdfCtx = pdfCanvas.getContext('2d');
    const overlayCanvas = document.getElementById('overlayCanvas');
    const oCtx = overlayCanvas.getContext('2d');

    const mushafContainer = document.getElementById('mushafContainer');
    const mushafImg = document.getElementById('mushafImg');
    const quranTextContainer = document.getElementById('quranTextContainer');
    const quranTextContent = document.getElementById('quranTextContent');
    const surahBadgeTitle = document.getElementById('surahBadgeTitle');
    const dragHeader = document.getElementById('dragHeader');
    const closeQuranCardBtn = document.getElementById('closeQuranCardBtn');
    const quranResizeCorner = document.getElementById('quranResizeCorner');
    const textWidgetsContainer = document.getElementById('textWidgetsContainer');

    let currentGrid = 'two-lines';
    let currentThemeBg = '#064e3b';
    let currentTool = 'pen';
    let currentColor = '#ffffff';
    let currentSize = 4;
    let currentOpacity = 1.0;
    let isDrawing = false;
    let startX = 0, startY = 0;

    let currentQuranPage = 1;
    let laserPoints = [];
    let history = [];
    let redoList = [];
    const MAX_HISTORY = 20;

    let currentPdf = null;
    let currentPdfPage = 1;
    let totalPdfPages = 0;
    const pageIndicator = document.getElementById('pageIndicator');

    // ====================================================================
    // نظام تحجيم الـ Scale والـ Zoom للعرض على البروجيكتور والشاشات
    // ====================================================================
    let currentScale = 1.0;
    const scaleIndicator = document.getElementById('scaleIndicator');
    const btnZoomIn = document.getElementById('btnZoomIn');
    const btnZoomOut = document.getElementById('btnZoomOut');

    function applyBoardScale(scale) {
      currentScale = Math.min(2.5, Math.max(0.4, scale));
      boardStage.style.transform = `scale(${currentScale})`;
      scaleIndicator.innerText = Math.round(currentScale * 100) + '%';
    }

    btnZoomIn.onclick = () => applyBoardScale(currentScale + 0.1);
    btnZoomOut.onclick = () => applyBoardScale(currentScale - 0.1);
    scaleIndicator.onclick = () => applyBoardScale(1.0);

    // ====================================================================
    // 1. تحريك وتحجيم صندوق المصحف من الحواف والأركان بشكل مستقل
    // ====================================================================
    let isDraggingQuranCard = false;
    let quranCardOffsetX = 0, quranCardOffsetY = 0;

    dragHeader.addEventListener('mousedown', (e) => {
      isDraggingQuranCard = true;
      const rect = quranTextContainer.getBoundingClientRect();
      quranCardOffsetX = (e.clientX - rect.left) / currentScale;
      quranCardOffsetY = (e.clientY - rect.top) / currentScale;
      e.stopPropagation();
    });

    // مقبض تكبير وتصغير صندوق المصحف من الزاوية
    let isResizingQuran = false;
    let startQW = 0, startQH = 0, startQMouseX = 0, startQMouseY = 0;

    quranResizeCorner.addEventListener('mousedown', (e) => {
      isResizingQuran = true;
      startQW = quranTextContainer.offsetWidth;
      startQH = quranTextContainer.offsetHeight;
      startQMouseX = e.clientX;
      startQMouseY = e.clientY;
      e.stopPropagation();
      e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
      if (isDraggingQuranCard) {
        const x = (e.clientX / currentScale) - quranCardOffsetX;
        const y = (e.clientY / currentScale) - quranCardOffsetY;
        quranTextContainer.style.left = x + 'px';
        quranTextContainer.style.top = y + 'px';
        quranTextContainer.style.transform = 'none';
      } else if (isResizingQuran) {
        const deltaX = (startQMouseX - e.clientX) / currentScale;
        const deltaY = (e.clientY - startQMouseY) / currentScale;
        quranTextContainer.style.width = Math.max(340, startQW + deltaX) + 'px';
        quranTextContainer.style.height = Math.max(220, startQH + deltaY) + 'px';
      }
    });

    window.addEventListener('mouseup', () => {
      isDraggingQuranCard = false;
      isResizingQuran = false;
    });

    closeQuranCardBtn.onclick = () => {
      quranTextContainer.style.display = 'none';
      stopQuranAudio();
    };

    // ====================================================================
    // 2. نظام الصناديق النصية المستقلة والتكبير الحر من الحواف
    // ====================================================================
    let widgetIdCounter = 0;

    function createCustomTextWidget(x, y) {
      widgetIdCounter++;
      const widget = document.createElement('div');
      widget.className = 'custom-textbox-widget';
      widget.id = `textWidget_${widgetIdCounter}`;
      widget.style.left = Math.min(x, window.innerWidth - 420) + 'px';
      widget.style.top = Math.min(y, window.innerHeight - 280) + 'px';

      widget.innerHTML = `
        <div class="widget-drag-bar">
          <span class="widget-drag-label">✥ اسحب لتحريك المربع بمفرده</span>
          <button class="w-del-btn" title="حذف هذا المربع">✕</button>
        </div>
        <div class="widget-toolbar">
          <select class="w-select font-family-sel" title="نوع الخط">
            <option value="'Traditional Arabic', 'Scheherazade New', serif">خط تقليدي (Traditional Arabic)</option>
            <option value="'Amiri Quran', 'Amiri', serif">خط المصحف (Amiri Quran)</option>
            <option value="'Reem Kufi', sans-serif">خط كوفي</option>
            <option value="Tahoma, Arial, sans-serif">خط نسخ مبسط</option>
          </select>
          <button class="w-btn font-dec-btn" title="تصغير الخط">A-</button>
          <button class="w-btn font-inc-btn" title="تكبير الخط">A+</button>
          <button class="w-btn bold-btn" title="عريض">B</button>
          <button class="w-btn italic-btn" title="مائل">I</button>
          <button class="w-btn align-btn" data-align="right" title="يمين">≡</button>
          <button class="w-btn align-btn" data-align="center" title="وسط">≣</button>
          <input type="color" class="color-picker-input" value="#ffffff" title="لون النص" style="width:22px; height:22px; border:none; border-radius:4px; cursor:pointer; background:none;">
        </div>
        <textarea class="w-editor-area" placeholder="اكتب الشرح أو القاعدة التجويدية هنا بطلاقة..."></textarea>
        <div class="resize-handle-corner" title="اسحب لتكبير أو تصغير حجم المربع"></div>
      `;

      textWidgetsContainer.appendChild(widget);

      const dragBar = widget.querySelector('.widget-drag-bar');
      const delBtn = widget.querySelector('.w-del-btn');
      const textarea = widget.querySelector('.w-editor-area');
      const fontSel = widget.querySelector('.font-family-sel');
      const decBtn = widget.querySelector('.font-dec-btn');
      const incBtn = widget.querySelector('.font-inc-btn');
      const boldBtn = widget.querySelector('.bold-btn');
      const italicBtn = widget.querySelector('.italic-btn');
      const alignBtns = widget.querySelectorAll('.align-btn');
      const colorInput = widget.querySelector('.color-picker-input');
      const resizeCorner = widget.querySelector('.resize-handle-corner');

      let currentFontSize = 30;

      let isDraggingThisWidget = false;
      let wOffsetX = 0, wOffsetY = 0;

      dragBar.addEventListener('mousedown', (e) => {
        isDraggingThisWidget = true;
        const rect = widget.getBoundingClientRect();
        wOffsetX = (e.clientX - rect.left) / currentScale;
        wOffsetY = (e.clientY - rect.top) / currentScale;
        e.stopPropagation();
      });

      let isResizingWidget = false;
      let startW = 0, startH = 0, startMouseX = 0, startMouseY = 0;

      resizeCorner.addEventListener('mousedown', (e) => {
        isResizingWidget = true;
        startW = widget.offsetWidth;
        startH = widget.offsetHeight;
        startMouseX = e.clientX;
        startMouseY = e.clientY;
        e.stopPropagation();
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e) => {
        if (isDraggingThisWidget) {
          widget.style.left = ((e.clientX / currentScale) - wOffsetX) + 'px';
          widget.style.top = ((e.clientY / currentScale) - wOffsetY) + 'px';
        } else if (isResizingWidget) {
          const deltaX = (startMouseX - e.clientX) / currentScale;
          const deltaY = (e.clientY - startMouseY) / currentScale;
          widget.style.width = Math.max(260, startW + deltaX) + 'px';
          widget.style.height = Math.max(160, startH + deltaY) + 'px';
        }
      });

      window.addEventListener('mouseup', () => {
        isDraggingThisWidget = false;
        isResizingWidget = false;
      });

      fontSel.onchange = () => { textarea.style.fontFamily = fontSel.value; };
      incBtn.onclick = () => { currentFontSize += 4; textarea.style.fontSize = currentFontSize + 'px'; };
      decBtn.onclick = () => { if (currentFontSize > 16) currentFontSize -= 4; textarea.style.fontSize = currentFontSize + 'px'; };
      
      let isB = false;
      boldBtn.onclick = () => { isB = !isB; boldBtn.classList.toggle('active', isB); textarea.style.fontWeight = isB ? 'bold' : 'normal'; };

      let isI = false;
      italicBtn.onclick = () => { isI = !isI; italicBtn.classList.toggle('active', isI); textarea.style.fontStyle = isI ? 'italic' : 'normal'; };

      alignBtns.forEach(b => {
        b.onclick = () => {
          alignBtns.forEach(btn => btn.classList.remove('active'));
          b.classList.add('active');
          textarea.style.textAlign = b.getAttribute('data-align');
        };
      });

      colorInput.oninput = () => { textarea.style.color = colorInput.value; };
      delBtn.onclick = () => { widget.remove(); };

      setTimeout(() => textarea.focus(), 60);
    }

    // ====================================================================
    // 3. قاعدة البيانات أوفلاين (IndexedDB)
    // ====================================================================
    let quranDB = null;
    function initIndexedDB() {
      const request = indexedDB.open('AlFatehQuranDB', 1);
      request.onupgradeneeded = (e) => {
        quranDB = e.target.result;
        if (!quranDB.objectStoreNames.contains('surahs')) {
          quranDB.createObjectStore('surahs', { keyPath: 'number' });
        }
      };
      request.onsuccess = (e) => { quranDB = e.target.result; };
    }
    initIndexedDB();

    document.getElementById('btnSyncQuranOffline').onclick = async () => {
      const btn = document.getElementById('btnSyncQuranOffline');
      btn.innerText = "⏳ جاري تحميل وتخزين السور أوفلاين...";
      try {
        const res = await fetch('https://api.alquran.cloud/v1/quran/quran-uthmani');
        const data = await res.json();
        if (data && data.data && data.data.surahs && quranDB) {
          const tx = quranDB.transaction('surahs', 'readwrite');
          const store = tx.objectStore('surahs');
          data.data.surahs.forEach(s => store.put(s));
          tx.oncomplete = () => {
            btn.innerText = "✓ تم حفظ القرآن كاملاً بنجاح للعمل دون إنترنت!";
            btn.style.background = "#059669";
            btn.style.borderColor = "#34d399";
          };
        }
      } catch (err) {
        btn.innerText = "تعذر الاتصال لتحميل النسخة، يرجى المحاولة عند توفر الإنترنت.";
      }
    };

    async function getSurahDataOfflineFirst(surahNum) {
      return new Promise((resolve, reject) => {
        if (quranDB) {
          const tx = quranDB.transaction('surahs', 'readonly');
          const store = tx.objectStore('surahs');
          const req = store.get(surahNum);
          req.onsuccess = () => {
            if (req.result) {
              resolve(req.result);
              return;
            }
            fetch(`https://api.alquran.cloud/v1/surah/${surahNum}/quran-uthmani`)
              .then(r => r.json())
              .then(d => resolve(d.data))
              .catch(e => reject(e));
          };
          req.onerror = () => {
            fetch(`https://api.alquran.cloud/v1/surah/${surahNum}/quran-uthmani`)
              .then(r => r.json())
              .then(d => resolve(d.data))
              .catch(e => reject(e));
          };
        } else {
          fetch(`https://api.alquran.cloud/v1/surah/${surahNum}/quran-uthmani`)
            .then(r => r.json())
            .then(d => resolve(d.data))
            .catch(e => reject(e));
        }
      });
    }

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        const swBlob = new Blob([`
          const CACHE_NAME = 'alfateh-whiteboard-v1';
          self.addEventListener('install', e => self.skipWaiting());
          self.addEventListener('fetch', e => {
            e.respondWith(
              caches.match(e.request).then(res => res || fetch(e.request).then(netRes => {
                return caches.open(CACHE_NAME).then(cache => {
                  if (e.request.url.startsWith('http')) cache.put(e.request, netRes.clone());
                  return netRes;
                });
              }).catch(() => caches.match(e.request)))
            );
          });
        `], { type: 'application/javascript' });
        navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(()=>{});
      });
    }

    // ====================================================================
    // 4. الصوتيات والمؤثرات التحفيزية
    // ====================================================================
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx = null;

    function getAudioContext() {
      if (!audioCtx) audioCtx = new AudioContext();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function playClapSound() {
      const ctx = getAudioContext();
      for (let i = 0; i < 18; i++) {
        setTimeout(() => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(140 + Math.random() * 260, ctx.currentTime);
          gain.gain.setValueAtTime(0.3, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.09);
        }, i * 45 + Math.random() * 20);
      }
    }

    function playChimeSound() {
      const ctx = getAudioContext();
      const notes = [523.25, 659.25, 783.99, 1046.50];
      notes.forEach((freq, idx) => {
        setTimeout(() => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, ctx.currentTime);
          gain.gain.setValueAtTime(0.35, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start();
          osc.stop(ctx.currentTime + 0.65);
        }, idx * 110);
      });
    }

    const celebrationOverlay = document.getElementById('celebrationOverlay');
    function triggerFloatingEffect(symbol, count = 25) {
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.className = 'floating-item';
        el.innerText = symbol;
        el.style.left = Math.random() * 95 + 'vw';
        el.style.animationDelay = (Math.random() * 0.8) + 's';
        el.style.fontSize = (26 + Math.random() * 24) + 'px';
        celebrationOverlay.appendChild(el);
        setTimeout(() => el.remove(), 3600);
      }
    }

    document.getElementById('btnClap').onclick = () => {
      playClapSound();
      confetti({ particleCount: 60, spread: 70, origin: { y: 0.7 } });
    };
    document.getElementById('btnStars').onclick = () => {
      playChimeSound();
      triggerFloatingEffect('⭐', 30);
    };
    document.getElementById('btnHearts').onclick = () => {
      playChimeSound();
      triggerFloatingEffect('💖', 30);
    };
    document.getElementById('btnParty').onclick = () => {
      playClapSound();
      playChimeSound();
      triggerFloatingEffect('🌟', 20);
      confetti({ particleCount: 120, spread: 100, origin: { y: 0.6 } });
    };

    document.getElementById('btnGoogleMeet').onclick = async () => {
      if (confirm("هل ترغب في بدء مشاركة الشاشة الحالية للمتصفح عبر Google Meet؟")) {
        try {
          if (navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia) {
            await navigator.mediaDevices.getDisplayMedia({ video: true });
          } else {
            window.open("https://meet.google.com/new", "_blank");
          }
        } catch (err) {
          window.open("https://meet.google.com/new", "_blank");
        }
      }
    };

    // ====================================================================
    // 5. مشغل التلاوة والفاصل الزمني والترديد
    // ====================================================================
    let activeAyahAudios = [];
    let activeAyahNumbers = [];
    let currentAudioIndex = 0;
    let isAudioPlaying = false;
    let currentAudioObj = new Audio();
    let currentLoopCount = 1;
    let currentLoopIteration = 1;
    let countdownInterval = null;

    const btnPlayAudio = document.getElementById('btnPlayAudio');
    const btnPrevAyah = document.getElementById('btnPrevAyah');
    const btnNextAyah = document.getElementById('btnNextAyah');
    const btnDownloadAudio = document.getElementById('btnDownloadAudio');
    const btnToggleBlur = document.getElementById('btnToggleBlur');
    const audioStatus = document.getElementById('audioStatus');
    const reciterSelect = document.getElementById('reciterSelect');
    const loopSelect = document.getElementById('loopSelect');
    const playbackSpeedSelect = document.getElementById('playbackSpeedSelect');
    const intervalSlider = document.getElementById('intervalSlider');
    const intervalSecDisplay = document.getElementById('intervalSecDisplay');
    const countdownBarContainer = document.getElementById('countdownBarContainer');
    const countdownBarFill = document.getElementById('countdownBarFill');

    intervalSlider.oninput = (e) => {
      intervalSecDisplay.innerText = e.target.value + ' ث';
    };

    playbackSpeedSelect.onchange = () => {
      currentAudioObj.playbackRate = parseFloat(playbackSpeedSelect.value);
    };

    let isTextBlurred = false;
    btnToggleBlur.onclick = () => {
      isTextBlurred = !isTextBlurred;
      if (isTextBlurred) {
        quranTextContent.classList.add('blurred-text');
        btnToggleBlur.innerText = "👁️ إظهار النص";
        btnToggleBlur.style.background = "#d97706";
      } else {
        quranTextContent.classList.remove('blurred-text');
        btnToggleBlur.innerText = "👁️ إخفاء النص";
        btnToggleBlur.style.background = "rgba(255, 255, 255, 0.08)";
      }
    };

    function setAyahHighlight(ayahNum) {
      document.querySelectorAll('.ayah-span').forEach(el => el.classList.remove('active-highlight'));
      const currentSpan = document.getElementById(`ayah-${ayahNum}`);
      if (currentSpan) {
        currentSpan.classList.add('active-highlight');
        currentSpan.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    function clearAllHighlights() {
      document.querySelectorAll('.ayah-span').forEach(el => el.classList.remove('active-highlight'));
    }

    function playAyahSequence(index) {
      if (!isAudioPlaying) return;

      if (index >= activeAyahAudios.length) {
        if (currentLoopIteration < currentLoopCount) {
          currentLoopIteration++;
          audioStatus.innerText = `🔄 إعادة التكرار (${currentLoopIteration} من ${currentLoopCount})`;
          playAyahSequence(0);
        } else {
          stopQuranAudio();
          audioStatus.innerText = "✓ اكتملت التلاوة وتكرار الآيات بنجاح";
        }
        return;
      }

      currentAudioIndex = index;
      const audioUrl = activeAyahAudios[index];
      const ayahNum = activeAyahNumbers[index];

      setAyahHighlight(ayahNum);

      currentAudioObj.src = audioUrl;
      currentAudioObj.playbackRate = parseFloat(playbackSpeedSelect.value);
      audioStatus.innerText = `▶ تلاوة آية (${ayahNum}) — [${index + 1}/${activeAyahAudios.length}]`;
      countdownBarContainer.style.display = 'none';

      currentAudioObj.play().catch(() => {
        setTimeout(() => playAyahSequence(index + 1), 500);
      });

      currentAudioObj.onended = () => {
        const pauseSeconds = parseInt(intervalSlider.value);
        if (pauseSeconds > 0 && index < activeAyahAudios.length - 1) {
          let totalMs = pauseSeconds * 1000;
          let elapsedMs = 0;
          
          countdownBarContainer.style.display = 'block';
          countdownBarFill.style.width = '100%';
          audioStatus.innerText = `⏳ فاصل زمني لترديد الطالب (${pauseSeconds} ثوانٍ)...`;

          if (countdownInterval) clearInterval(countdownInterval);
          countdownInterval = setInterval(() => {
            elapsedMs += 100;
            let percent = 100 - (elapsedMs / totalMs) * 100;
            countdownBarFill.style.width = Math.max(0, percent) + '%';

            let secLeft = Math.ceil((totalMs - elapsedMs) / 1000);
            if (secLeft > 0) {
              audioStatus.innerText = `⏳ فاصل زمني لترديد الطالب (${secLeft} ثوانٍ)...`;
            } else {
              clearInterval(countdownInterval);
              countdownBarContainer.style.display = 'none';
              playAyahSequence(index + 1);
            }
          }, 100);
        } else {
          playAyahSequence(index + 1);
        }
      };
    }

    function stopQuranAudio() {
      isAudioPlaying = false;
      if (countdownInterval) clearInterval(countdownInterval);
      countdownBarContainer.style.display = 'none';
      currentAudioObj.pause();
      currentAudioObj.currentTime = 0;
      clearAllHighlights();
      btnPlayAudio.innerText = "▶️ تشغيل التلاوة";
      btnPlayAudio.style.background = "#0284c7";
    }

    btnPlayAudio.onclick = (e) => {
      e.stopPropagation();
      if (activeAyahAudios.length === 0) {
        alert("يرجى إدراج الآيات أولاً عبر نافذة آيات القرآن.");
        return;
      }
      if (isAudioPlaying) {
        stopQuranAudio();
        audioStatus.innerText = "تم الإيقاف المؤقت للتلاوة";
      } else {
        isAudioPlaying = true;
        currentLoopCount = parseInt(loopSelect.value);
        currentLoopIteration = 1;
        btnPlayAudio.innerText = "⏸️ إيقاف مؤقت";
        btnPlayAudio.style.background = "#dc2626";
        playAyahSequence(currentAudioIndex);
      }
    };

    btnNextAyah.onclick = (e) => {
      e.stopPropagation();
      if (activeAyahAudios.length > 0 && currentAudioIndex < activeAyahAudios.length - 1) {
        if (countdownInterval) clearInterval(countdownInterval);
        isAudioPlaying = true;
        btnPlayAudio.innerText = "⏸️ إيقاف مؤقت";
        btnPlayAudio.style.background = "#dc2626";
        playAyahSequence(currentAudioIndex + 1);
      }
    };

    btnPrevAyah.onclick = (e) => {
      e.stopPropagation();
      if (activeAyahAudios.length > 0 && currentAudioIndex > 0) {
        if (countdownInterval) clearInterval(countdownInterval);
        isAudioPlaying = true;
        btnPlayAudio.innerText = "⏸️ إيقاف مؤقت";
        btnPlayAudio.style.background = "#dc2626";
        playAyahSequence(currentAudioIndex - 1);
      }
    };

    btnDownloadAudio.onclick = async (e) => {
      e.stopPropagation();
      if (activeAyahAudios.length === 0) {
        alert("يرجى إدراج الآيات أولاً لحفظ صوتياتها.");
        return;
      }
      btnDownloadAudio.innerText = "جاري الحفظ...";
      audioStatus.innerText = "⏳ جاري حفظ ملفات الصوت للعمل دون إنترنت...";

      try {
        if ('caches' in window) {
          const cache = await caches.open('quran-audio-cache');
          for (let i = 0; i < activeAyahAudios.length; i++) {
            await cache.add(activeAyahAudios[i]);
          }
          btnDownloadAudio.innerText = "✓ تم الحفظ أوفلاين";
          audioStatus.innerText = "✓ تم حفظ تلاوة الآيات محلياً بنجاح.";
        } else {
          window.open(activeAyahAudios[0], '_blank');
          btnDownloadAudio.innerText = "📥 حفظ أوفلاين";
        }
      } catch (err) {
        btnDownloadAudio.innerText = "📥 حفظ أوفلاين";
        audioStatus.innerText = "روابط الصوتيات جاهزة ومحدثة للعمل.";
      }
    };

    reciterSelect.onchange = () => {
      stopQuranAudio();
      updateAudioListForCurrentAyahs();
    };

    function updateAudioListForCurrentAyahs() {
      const reciter = reciterSelect.value;
      const surahIdx = parseInt(textSurahSelect.value);
      const fromV = parseInt(document.getElementById('verseFrom').value) || 1;
      const toV = parseInt(document.getElementById('verseTo').value) || fromV;

      activeAyahAudios = [];
      activeAyahNumbers = [];

      for (let v = fromV; v <= toV; v++) {
        const sPad = String(surahIdx).padStart(3, '0');
        const vPad = String(v).padStart(3, '0');
        const audioUrl = `https://everyayah.com/data/${reciter}/${sPad}${vPad}.mp3`;
        activeAyahAudios.push(audioUrl);
        activeAyahNumbers.push(v);
      }
      audioStatus.innerText = `جاهز للاستماع بصوت القارئ المختار (${activeAyahAudios.length} آيات)`;
    }

    // ====================================================================
    // 6. منطق الرسم على الكانفاس وسحب السبورة بالأيدي
    // ====================================================================
    function resizeCanvases() {
      const tempCanvas = document.createElement('canvas');
      tempCanvas.width = paintCanvas.width;
      tempCanvas.height = paintCanvas.height;
      const tCtx = tempCanvas.getContext('2d');
      tCtx.drawImage(paintCanvas, 0, 0);

      [paintCanvas, gridCanvas, pdfCanvas, overlayCanvas].forEach(c => {
        c.width = window.innerWidth;
        c.height = window.innerHeight;
      });

      pCtx.drawImage(tempCanvas, 0, 0);
      drawGrid();
      if (currentPdf) renderPdfPage(currentPdfPage);
    }
    window.addEventListener('resize', resizeCanvases);

    [paintCanvas, gridCanvas, pdfCanvas, overlayCanvas].forEach(c => {
      c.width = window.innerWidth;
      c.height = window.innerHeight;
    });

    function drawGrid() {
      gCtx.clearRect(0, 0, gridCanvas.width, gridCanvas.height);
      if (currentGrid === 'none') return;

      const isLight = currentThemeBg === '#ffffff';
      gCtx.strokeStyle = isLight ? 'rgba(0, 0, 0, 0.08)' : 'rgba(255, 255, 255, 0.08)';
      gCtx.lineWidth = 1;

      if (currentGrid === 'ruled' || currentGrid === 'wide-ruled') {
        const space = currentGrid === 'wide-ruled' ? 56 : 42;
        for (let y = space; y < gridCanvas.height; y += space) {
          gCtx.beginPath();
          gCtx.moveTo(0, y);
          gCtx.lineTo(gridCanvas.width, y);
          gCtx.stroke();
        }
      } else if (currentGrid === 'two-lines') {
        for (let y = 50; y < gridCanvas.height; y += 70) {
          gCtx.beginPath();
          gCtx.moveTo(0, y);
          gCtx.lineTo(gridCanvas.width, y);
          gCtx.moveTo(0, y + 24);
          gCtx.lineTo(gridCanvas.width, y + 24);
          gCtx.stroke();
        }
      } else if (currentGrid === 'four-lines') {
        for (let y = 50; y < gridCanvas.height; y += 90) {
          for (let i = 0; i < 4; i++) {
            gCtx.beginPath();
            gCtx.moveTo(0, y + i * 16);
            gCtx.lineTo(gridCanvas.width, y + i * 16);
            gCtx.stroke();
          }
        }
      } else if (currentGrid === 'graph') {
        const step = 38;
        for (let x = 0; x < gridCanvas.width; x += step) {
          gCtx.beginPath();
          gCtx.moveTo(x, 0);
          gCtx.lineTo(x, gridCanvas.height);
          gCtx.stroke();
        }
        for (let y = 0; y < gridCanvas.height; y += step) {
          gCtx.beginPath();
          gCtx.moveTo(0, y);
          gCtx.lineTo(gridCanvas.width, y);
          gCtx.stroke();
        }
      }
    }
    drawGrid();

    function saveState() {
      if (history.length >= MAX_HISTORY) history.shift();
      history.push(pCtx.getImageData(0, 0, paintCanvas.width, paintCanvas.height));
      redoList = [];
    }
    saveState();

    function getCoords(e) {
      const rect = paintCanvas.getBoundingClientRect();
      let clientX = e.clientX;
      let clientY = e.clientY;
      if (e.touches && e.touches[0]) {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      }
      return {
        x: (clientX - rect.left) / currentScale,
        y: (clientY - rect.top) / currentScale
      };
    }

    function drawArrow(targetCtx, fromX, fromY, toX, toY, color, size) {
      const angle = Math.atan2(toY - fromY, toX - fromX);
      const headLength = Math.max(18, size * 3.5);

      targetCtx.beginPath();
      targetCtx.moveTo(fromX, fromY);
      targetCtx.lineTo(toX, toY);
      targetCtx.strokeStyle = color;
      targetCtx.lineWidth = size;
      targetCtx.lineCap = 'round';
      targetCtx.stroke();

      targetCtx.beginPath();
      targetCtx.moveTo(toX, toY);
      targetCtx.lineTo(toX - headLength * Math.cos(angle - Math.PI / 6), toY - headLength * Math.sin(angle - Math.PI / 6));
      targetCtx.lineTo(toX - (headLength * 0.7) * Math.cos(angle), toY - (headLength * 0.7) * Math.sin(angle));
      targetCtx.lineTo(toX - headLength * Math.cos(angle + Math.PI / 6), toY - headLength * Math.sin(angle + Math.PI / 6));
      targetCtx.closePath();
      targetCtx.fillStyle = color;
      targetCtx.fill();
    }

    let isPanningCanvas = false;
    let panStartX = 0, panStartY = 0;

    function startDraw(e) {
      const { x, y } = getCoords(e);
      startX = x;
      startY = y;

      if (currentTool === 'text') {
        createCustomTextWidget(x, y);
        return;
      }

      if (currentTool === 'hand') {
        isPanningCanvas = true;
        panStartX = x;
        panStartY = y;
        paintCanvas.style.cursor = 'grabbing';
        return;
      }

      isDrawing = true;

      if (['pen', 'highlighter', 'eraser'].includes(currentTool)) {
        pCtx.beginPath();
        pCtx.moveTo(x, y);

        if (currentTool === 'eraser') {
          pCtx.globalCompositeOperation = 'destination-out';
          pCtx.lineWidth = currentSize * 4;
        } else {
          pCtx.globalCompositeOperation = 'source-over';
          pCtx.strokeStyle = currentTool === 'highlighter' ? currentColor + '55' : currentColor;
          pCtx.globalAlpha = currentTool === 'highlighter' ? 0.4 : currentOpacity;
          pCtx.lineWidth = currentTool === 'highlighter' ? currentSize * 3 : currentSize;
        }
        pCtx.lineCap = 'round';
        pCtx.lineJoin = 'round';
      } else if (currentTool === 'laser') {
        laserPoints.push({ x, y, time: Date.now() });
      }
    }

    function draw(e) {
      const { x, y } = getCoords(e);

      if (isPanningCanvas && currentTool === 'hand') {
        const dx = x - panStartX;
        const dy = y - panStartY;
        panStartX = x;
        panStartY = y;

        const temp = document.createElement('canvas');
        temp.width = paintCanvas.width;
        temp.height = paintCanvas.height;
        temp.getContext('2d').drawImage(paintCanvas, 0, 0);

        pCtx.clearRect(0, 0, paintCanvas.width, paintCanvas.height);
        pCtx.drawImage(temp, dx, dy);
        return;
      }

      if (!isDrawing) return;

      if (['pen', 'highlighter', 'eraser'].includes(currentTool)) {
        pCtx.lineTo(x, y);
        pCtx.stroke();
      } else if (currentTool === 'laser') {
        laserPoints.push({ x, y, time: Date.now() });
      } else {
        oCtx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);
        if (currentTool === 'arrow') {
          drawArrow(oCtx, startX, startY, x, y, currentColor, currentSize);
        } else {
          oCtx.strokeStyle = currentColor;
          oCtx.lineWidth = currentSize;
          oCtx.lineCap = 'round';
          if (currentTool === 'line') {
            oCtx.beginPath();
            oCtx.moveTo(startX, startY);
            oCtx.lineTo(x, y);
            oCtx.stroke();
          } else if (currentTool === 'rect') {
            oCtx.strokeRect(startX, startY, x - startX, y - startY);
          } else if (currentTool === 'circle') {
            oCtx.beginPath();
            oCtx.arc(startX, startY, Math.hypot(x - startX, y - startY), 0, Math.PI * 2);
            oCtx.stroke();
          }
        }
      }
    }

    function stopDraw(e) {
      if (isPanningCanvas) {
        isPanningCanvas = false;
        paintCanvas.style.cursor = 'grab';
        saveState();
        return;
      }

      if (!isDrawing) return;
      isDrawing = false;
      const { x, y } = getCoords(e);

      if (['pen', 'highlighter', 'eraser'].includes(currentTool)) {
        pCtx.closePath();
        pCtx.globalAlpha = 1.0;
        saveState();
      } else if (['line', 'arrow', 'rect', 'circle'].includes(currentTool)) {
        oCtx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);
        pCtx.globalCompositeOperation = 'source-over';
        pCtx.globalAlpha = currentOpacity;
        if (currentTool === 'arrow') {
          drawArrow(pCtx, startX, startY, x, y, currentColor, currentSize);
        } else {
          pCtx.strokeStyle = currentColor;
          pCtx.lineWidth = currentSize;
          pCtx.lineCap = 'round';
          if (currentTool === 'line') {
            pCtx.beginPath();
            pCtx.moveTo(startX, startY);
            pCtx.lineTo(x, y);
            pCtx.stroke();
          } else if (currentTool === 'rect') {
            pCtx.strokeRect(startX, startY, x - startX, y - startY);
          } else if (currentTool === 'circle') {
            pCtx.beginPath();
            pCtx.arc(startX, startY, Math.hypot(x - startX, y - startY), 0, Math.PI * 2);
            pCtx.stroke();
          }
        }
        pCtx.globalAlpha = 1.0;
        saveState();
      }
    }

    function renderLaser() {
      if (laserPoints.length > 0) {
        oCtx.clearRect(0, 0, overlayCanvas.width, overlayCanvas.height);
        const now = Date.now();
        laserPoints = laserPoints.filter(p => now - p.time < 1200);

        for (let i = 1; i < laserPoints.length; i++) {
          const alpha = 1 - (now - laserPoints[i].time) / 1200;
          oCtx.strokeStyle = `rgba(239, 68, 68, ${alpha})`;
          oCtx.lineWidth = 6;
          oCtx.lineCap = 'round';
          oCtx.beginPath();
          oCtx.moveTo(laserPoints[i - 1].x, laserPoints[i - 1].y);
          oCtx.lineTo(laserPoints[i].x, laserPoints[i].y);
          oCtx.stroke();
        }
      }
      requestAnimationFrame(renderLaser);
    }
    renderLaser();

    paintCanvas.addEventListener('mousedown', startDraw);
    paintCanvas.addEventListener('mousemove', draw);
    window.addEventListener('mouseup', stopDraw);

    paintCanvas.addEventListener('touchstart', (e) => { e.preventDefault(); startDraw(e); }, { passive: false });
    paintCanvas.addEventListener('touchmove', (e) => { e.preventDefault(); draw(e); }, { passive: false });
    window.addEventListener('touchend', (e) => { stopDraw(e); });

    document.querySelectorAll('[data-tool]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-tool]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentTool = btn.getAttribute('data-tool');

        if (currentTool === 'hand') {
          paintCanvas.style.cursor = 'grab';
        } else if (currentTool === 'text') {
          paintCanvas.style.cursor = 'text';
        } else {
          paintCanvas.style.cursor = 'crosshair';
        }
      });
    });

    document.querySelectorAll('[data-color]').forEach(dot => {
      dot.addEventListener('click', () => {
        document.querySelectorAll('[data-color]').forEach(d => d.classList.remove('active'));
        dot.classList.add('active');
        currentColor = dot.getAttribute('data-color');
        if (currentTool === 'eraser') {
          document.querySelector('[data-tool="pen"]').click();
        }
      });
    });

    document.querySelectorAll('[data-bg]').forEach(dot => {
      dot.addEventListener('click', () => {
        document.querySelectorAll('[data-bg]').forEach(d => d.classList.remove('active'));
        dot.classList.add('active');
        currentThemeBg = dot.getAttribute('data-bg');
        document.body.style.backgroundColor = currentThemeBg;
        drawGrid();
      });
    });

    document.querySelectorAll('[data-grid]').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-grid]').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentGrid = btn.getAttribute('data-grid');
        drawGrid();
      });
    });

    document.getElementById('brushSize').oninput = (e) => {
      currentSize = parseInt(e.target.value);
      document.getElementById('sizeVal').innerText = currentSize + 'px';
    };
    document.getElementById('brushOpacity').oninput = (e) => {
      currentOpacity = parseInt(e.target.value) / 100;
      document.getElementById('opacityVal').innerText = e.target.value + '%';
    };

    document.getElementById('undoBtn').onclick = () => {
      if (history.length > 1) {
        redoList.push(history.pop());
        pCtx.putImageData(history[history.length - 1], 0, 0);
      }
    };
    document.getElementById('redoBtn').onclick = () => {
      if (redoList.length > 0) {
        const nextState = redoList.pop();
        history.push(nextState);
        pCtx.putImageData(nextState, 0, 0);
      }
    };

    document.getElementById('clearBoardBtn').onclick = () => {
      if (confirm('مسح كامل محتوى السبورة والشروحات؟')) {
        pCtx.clearRect(0, 0, paintCanvas.width, paintCanvas.height);
        pdfCtx.clearRect(0, 0, pdfCanvas.width, pdfCanvas.height);
        mushafContainer.style.display = 'none';
        quranTextContainer.style.display = 'none';
        textWidgetsContainer.innerHTML = '';
        stopQuranAudio();
        currentPdf = null;
        pageIndicator.innerText = "صفحة 1 / 1";
        saveState();
      }
    };

    document.getElementById('fullScreenBtn').onclick = () => {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen();
      } else {
        document.exitFullscreen();
      }
    };

    const leftPanel = document.getElementById('leftPanel');
    const rightPanel = document.getElementById('rightPanel');
    const toggleLeftBtn = document.getElementById('toggleLeftBtn');
    const toggleRightBtn = document.getElementById('toggleRightBtn');

    document.getElementById('closeLeftBtn').onclick = () => {
      leftPanel.classList.add('closed-left');
      toggleLeftBtn.style.display = 'block';
    };
    toggleLeftBtn.onclick = () => {
      leftPanel.classList.remove('closed-left');
      toggleLeftBtn.style.display = 'none';
    };

    document.getElementById('closeRightBtn').onclick = () => {
      rightPanel.classList.add('closed-right');
      toggleRightBtn.style.display = 'block';
    };
    toggleRightBtn.onclick = () => {
      rightPanel.classList.remove('closed-right');
      toggleRightBtn.style.display = 'none';
    };

    // رفع واستعراض PDF
    const pdfInput = document.getElementById('pdfInput');
    document.getElementById('uploadPdfBtn').onclick = () => pdfInput.click();

    pdfInput.onchange = function(e) {
      const file = e.target.files[0];
      if (file && file.type === 'application/pdf') {
        const fileReader = new FileReader();
        fileReader.onload = function() {
          const typedarray = new Uint8Array(this.result);
          pdfjsLib.getDocument(typedarray).promise.then(pdf => {
            currentPdf = pdf;
            totalPdfPages = pdf.numPages;
            currentPdfPage = 1;
            mushafContainer.style.display = 'none';
            quranTextContainer.style.display = 'none';
            stopQuranAudio();
            renderPdfPage(currentPdfPage);
          });
        };
        fileReader.readAsArrayBuffer(file);
      }
    };

    function renderPdfPage(pageNumber) {
      if (!currentPdf) return;
      currentPdf.getPage(pageNumber).then(page => {
        const viewport = page.getViewport({ scale: 1 });
        const scale = Math.min((pdfCanvas.width * 0.55) / viewport.width, (pdfCanvas.height * 0.88) / viewport.height);
        const scaledViewport = page.getViewport({ scale: scale });

        pdfCtx.clearRect(0, 0, pdfCanvas.width, pdfCanvas.height);
        const x = (pdfCanvas.width - scaledViewport.width) / 2;
        const y = (pdfCanvas.height - scaledViewport.height) / 2;

        page.render({
          canvasContext: pdfCtx,
          viewport: scaledViewport,
          transform: [1, 0, 0, 1, x, y]
        });
        pageIndicator.innerText = `صفحة PDF: ${pageNumber} / ${totalPdfPages}`;
      });
    }

    document.getElementById('prevPageBtn').onclick = () => {
      if (currentPdf && currentPdfPage > 1) {
        currentPdfPage--;
        renderPdfPage(currentPdfPage);
      } else if (mushafContainer.style.display === 'block' && currentQuranPage > 1) {
        loadMushafPage(currentQuranPage - 1);
      }
    };
    document.getElementById('nextPageBtn').onclick = () => {
      if (currentPdf && currentPdfPage < totalPdfPages) {
        currentPdfPage++;
        renderPdfPage(currentPdfPage);
      } else if (mushafContainer.style.display === 'block' && currentQuranPage < 604) {
        loadMushafPage(currentQuranPage + 1);
      }
    };

    // قائمة السور
    const surahData = [
      { name: "الفاتحة", page: 1 }, { name: "البقرة", page: 2 }, { name: "آل عمران", page: 50 },
