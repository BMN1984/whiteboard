    ];

    const quickSurahSelect = document.getElementById('quickSurahSelect');
    const textSurahSelect = document.getElementById('textSurahSelect');

    surahData.forEach((s, idx) => {
      const opt1 = document.createElement('option');
      opt1.value = s.page;
      opt1.innerText = `${idx + 1}. سورة ${s.name} (صفحة ${s.page})`;
      quickSurahSelect.appendChild(opt1);

      const opt2 = document.createElement('option');
      opt2.value = idx + 1;
      opt2.innerText = `${idx + 1}. سورة ${s.name}`;
      textSurahSelect.appendChild(opt2);
    });

    quickSurahSelect.onchange = () => {
      document.getElementById('quranPageInput').value = quickSurahSelect.value;
    };

    const quranModal = document.getElementById('quranModal');
    const openQuranBtn = document.getElementById('openQuranBtn');
    const closeQuranModalBtn = document.getElementById('closeQuranModalBtn');
    const cancelQuranModalBtn = document.getElementById('cancelQuranModalBtn');
    const tabMushafImage = document.getElementById('tabMushafImage');
    const tabCustomText = document.getElementById('tabCustomText');
    const mushafImageSection = document.getElementById('mushafImageSection');
    const customTextSection = document.getElementById('customTextSection');
    let quranDisplayMode = 'text';

    openQuranBtn.onclick = () => {
      quranDisplayMode = 'text';
      tabCustomText.classList.add('active');
      tabMushafImage.classList.remove('active');
      customTextSection.style.display = 'flex';
      mushafImageSection.style.display = 'none';
      document.getElementById('submitBtnText').innerText = "إدراج الآيات المزخرفة الملونة";
      quranModal.classList.add('active');
    };

    closeQuranModalBtn.onclick = () => quranModal.classList.remove('active');
    cancelQuranModalBtn.onclick = () => quranModal.classList.remove('active');

    tabCustomText.onclick = () => {
      quranDisplayMode = 'text';
      tabCustomText.classList.add('active');
      tabMushafImage.classList.remove('active');
      customTextSection.style.display = 'flex';
      mushafImageSection.style.display = 'none';
      document.getElementById('submitBtnText').innerText = "إدراج الآيات المزخرفة الملونة";
    };

    tabMushafImage.onclick = () => {
      quranDisplayMode = 'image';
      tabMushafImage.classList.add('active');
      tabCustomText.classList.remove('active');
      mushafImageSection.style.display = 'block';
      customTextSection.style.display = 'none';
      document.getElementById('submitBtnText').innerText = "إدراج الصفحة المصورة";
    };

    let selectedTextColor = '#fef08a';
    const quranColorDots = document.querySelectorAll('.quran-color-dot');
    quranColorDots.forEach(dot => {
      dot.addEventListener('click', () => {
        quranColorDots.forEach(d => d.classList.remove('active'));
        dot.classList.add('active');
        selectedTextColor = dot.getAttribute('data-text-color');
        document.getElementById('customColorInput').value = selectedTextColor;
      });
    });

    document.getElementById('customColorInput').oninput = (e) => {
      selectedTextColor = e.target.value;
      quranColorDots.forEach(d => d.classList.remove('active'));
    };

    const quranFontSizeSlider = document.getElementById('quranFontSizeSlider');
    const fontSizeDisplay = document.getElementById('fontSizeDisplay');
    quranFontSizeSlider.oninput = (e) => {
      fontSizeDisplay.innerText = e.target.value + 'px';
    };

    function loadMushafPage(pageNum) {
      currentQuranPage = pageNum;
      const formatted3 = String(pageNum).padStart(3, '0');
      
      const urls = [
        `https://images.quran.com/mushaf/page${pageNum}.png`,
        `https://raw.githubusercontent.com/zonetecde/mushaf-layout/refs/heads/main/mushaf-images/page-${formatted3}.png`,
        `https://quran.ksu.edu.sa/ayat/safahat/${pageNum}.png`
      ];

      let attempt = 0;
      function tryLoad() {
        if (attempt >= urls.length) {
          alert('تعذر تحميل صورة الصفحة، يرجى استخدام نمط "خط عريض ومزخرف وملون" لعرض الآيات.');
          return;
        }
        mushafImg.onerror = () => {
          attempt++;
          tryLoad();
        };
        mushafImg.onload = () => {
          mushafContainer.style.display = 'block';
          quranTextContainer.style.display = 'none';
          stopQuranAudio();
          pCtx.clearRect(0, 0, paintCanvas.width, paintCanvas.height);
          saveState();
          pageIndicator.innerText = `مصحف: صفحة ${pageNum}`;
          quranModal.classList.remove('active');
        };
        mushafImg.src = urls[attempt];
      }
      tryLoad();
    }

    document.getElementById('submitQuranBtn').onclick = async () => {
      if (quranDisplayMode === 'text') {
        const surahIdx = parseInt(textSurahSelect.value);
        const surahObj = surahData[surahIdx - 1];
        const fromV = parseInt(document.getElementById('verseFrom').value) || 1;
        const toV = parseInt(document.getElementById('verseTo').value) || fromV;
        const fSize = quranFontSizeSlider.value + 'px';

        document.getElementById('submitBtnText').innerText = "جاري جلب الآيات...";

        try {
          const surahResult = await getSurahDataOfflineFirst(surahIdx);
          const verses = surahResult.ayahs.filter(a => a.numberInSurah >= fromV && a.numberInSurah <= toV);
          
          if (verses.length === 0) {
            alert('تأكد من كتابة أرقام آيات صحيحة لهذه السورة.');
            document.getElementById('submitBtnText').innerText = "إدراج الآيات المزخرفة الملونة";
            return;
          }

          const fullVersesHtml = verses.map(a => 
            `<span class="ayah-span" id="ayah-${a.numberInSurah}">${a.text} <span style="color:#f59e0b; font-size:0.88em; text-shadow:none;">﴿${a.numberInSurah}﴾</span></span>`
          ).join(' ');

          surahBadgeTitle.innerText = `سورة ${surahObj.name} (الآيات ${fromV} - ${toV})`;
          quranTextContent.innerHTML = fullVersesHtml;
          quranTextContent.style.color = selectedTextColor;
          quranTextContent.style.fontSize = fSize;

          updateAudioListForCurrentAyahs();

          mushafContainer.style.display = 'none';
          quranTextContainer.style.display = 'flex';

          quranTextContainer.style.top = '16%';
          quranTextContainer.style.left = '20%';
          quranTextContainer.style.transform = 'none';

          pCtx.clearRect(0, 0, paintCanvas.width, paintCanvas.height);
          saveState();

          pageIndicator.innerText = `آيات: سورة ${surahObj.name}`;
          quranModal.classList.remove('active');
          document.getElementById('submitBtnText').innerText = "إدراج الآيات المزخرفة الملونة";
        } catch (err) {
          alert('تعذر جلب الآيات، يرجى التأكد من الاتصال بالإنترنت أو تنزيل السور أوفلاين.');
          document.getElementById('submitBtnText').innerText = "إدراج الآيات المزخرفة الملونة";
        }
      } else {
        const pageNum = parseInt(document.getElementById('quranPageInput').value) || 1;
        if (pageNum < 1 || pageNum > 604) {
          alert('يرجى إدخال رقم صفحة صحيح من 1 إلى 604');
          return;
        }
        loadMushafPage(pageNum);
      }
    };

    const imageInput = document.getElementById('imageInput');
    document.getElementById('uploadImgBtn').onclick = () => imageInput.click();

    function placeImage(src) {
      const img = new Image();
      img.onload = () => {
        const maxWidth = (paintCanvas.width - 500);
        const scale = Math.min(1, maxWidth / img.width);
        const w = img.width * scale;
        const h = img.height * scale;
        pCtx.drawImage(img, (paintCanvas.width - w) / 2, (paintCanvas.height - h) / 2, w, h);
        saveState();
      };
      img.src = src;
    }

    imageInput.onchange = (e) => {
      const file = e.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = (ev) => placeImage(ev.target.result);
        reader.readAsDataURL(file);
      }
    };

    function exportImage(format) {
      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = paintCanvas.width;
      exportCanvas.height = paintCanvas.height;
      const eCtx = exportCanvas.getContext('2d');

      eCtx.fillStyle = currentThemeBg;
      eCtx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);
      eCtx.drawImage(gridCanvas, 0, 0);

      if (mushafContainer.style.display === 'block' && mushafImg.complete) {
        const rect = mushafImg.getBoundingClientRect();
        eCtx.drawImage(mushafImg, rect.left, rect.top, rect.width, rect.height);
      }

      eCtx.drawImage(pdfCanvas, 0, 0);
      eCtx.drawImage(paintCanvas, 0, 0);

      const link = document.createElement('a');
      link.download = `سبورة-أكاديمية-الفتح-${Date.now()}.${format}`;
      link.href = exportCanvas.toDataURL(`image/${format === 'png' ? 'png' : 'jpeg'}`);
      link.click();
    }

    document.getElementById('downloadPngBtn').onclick = () => exportImage('png');
    document.getElementById('downloadJpgBtn').onclick = () => exportImage('jpeg');
    document.getElementById('quickSaveBtn').onclick = () => exportImage('png');
  </script>
</body>
</html>
